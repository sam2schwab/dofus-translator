{
  "manifest_version": 3,
  "name": "Dofus Translator",
  "version": "1.0",
  "description": "Translates Dofus-specific keywords on the page using official translations.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "activeTab", "storage"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "options_page": "src/options.html",
  "options_ui": {
    "page": "src/options.html"
  },
  "host_permissions": ["*://www.dofuspourlesnoobs.com/*"],
  "content_scripts": [
    {
      "matches": ["*://www.dofuspourlesnoobs.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dofus-translate@isthos.com"
    }
  }
}
